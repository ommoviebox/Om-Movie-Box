rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /titles/{titleId} {
      // Public users can read published catalogue entries only.
      allow read: if resource.data.published == true
                  || (request.auth != null && request.auth.uid == "REPLACE_WITH_ADMIN_UID");

      // Only the explicitly configured admin UID can write.
      allow create: if request.auth != null
                    && request.auth.uid == "REPLACE_WITH_ADMIN_UID"
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
                    && request.auth.uid == "REPLACE_WITH_ADMIN_UID"
                    && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if request.auth != null
                    && request.auth.uid == "REPLACE_WITH_ADMIN_UID";
    }
  }
}
